# =========================
# Project basics
# =========================
PROJECT_NAME=Xplore.ai

# =========================
# Database
# Format: postgresql+psycopg://user:password@host:port/database
# Local development: localhost
# Docker Compose: overridden to db:5432
# =========================
# Host tools: use 5433 (Compose publishes db on localhost:5433).
# Inside Compose, the API overrides this to db:5432.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/xplore_db

# Redis cache / message broker
# Format: redis://password@host:port/db_index
REDIS_URL=redis://localhost:6379/0

# =========================
# JWT authentication
# SECRET_KEY: must be replaced in production; prefer openssl rand -hex 32
#   make setup generates a random value automatically
# ALGORITHM: signing algorithm (default HS256)
# ACCESS_TOKEN_EXPIRE_MINUTES: token lifetime in minutes
# =========================
SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# CORS
# Comma-separated allowed origins, including frontend dev URLs
# =========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# =========================
# Logging
# text: human-readable (recommended for local development)
# json: structured JSON (recommended for production)
# =========================
LOG_FORMAT=text

# =========================
# LLM configuration (OpenAI-compatible API)
# LLM_PROVIDER: openai | anthropic | gemini | deepseek | ollama | openai_compatible
# LLM_API_KEY: API key (leave empty to auto-enable Mock mode)
#   Users can also set a personal key in Settings after sign-in (BYOK)
# LLM_BASE_URL: API endpoint (optional; provider defaults apply when empty)
# LLM_MODEL_NAME: model name, e.g. deepseek-chat / gpt-4o-mini / gemini-2.0-flash
# Embeddings are configured separately via EMBEDDING_* (not tied to chat provider)
# =========================
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# Mock mode — set true to use canned replies without an API key
# Note: Mock also enables automatically when LLM_API_KEY is empty
LLM_MOCK=false

# =========================
# Embedding configuration (independent of LLM; usually local Ollama)
# EMBEDDING_BASE_URL: Ollama OpenAI-compatible endpoint
# EMBEDDING_MODEL_NAME: embedding model, e.g. bge-m3 / text-embedding-3-small
# EMBEDDING_DIMENSION: vector size; must match the model
# =========================
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_DIMENSION=1024

# Ollama base URL (used for health checks)
OLLAMA_BASE_URL=http://localhost:11434/v1

# =========================
# LLM cost estimates (billing estimates only; does not affect features)
# Unit: USD per 1K tokens
# Set to 0 to skip cost calculation
# =========================
LLM_INPUT_PRICE_PER_1K_TOKENS=0
LLM_OUTPUT_PRICE_PER_1K_TOKENS=0

# =========================
# RAG retrieval
# Hybrid = vector + PostgreSQL full-text (RRF). Falls back to vector-only on SQLite
# or when keyword search fails. Rerank uses BGE CrossEncoder when available.
# =========================
RAG_ENABLE_HYBRID=true
RAG_ENABLE_RERANK=true
RAG_VECTOR_CANDIDATES=20
RAG_KEYWORD_CANDIDATES=20
